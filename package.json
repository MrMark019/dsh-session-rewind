{
  "name": "@mrmark019/dsh-session-rewind",
  "version": "1.0.0",
  "private": true,
  "description": "Rewind a completed turn: fork the conversation before it and restore the workspace from a private git snapshot",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "rewind",
    "locale/*.json",
    "docs",
    "icon.svg",
    "scripts"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}